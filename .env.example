# Copy to .env and fill in. Never commit .env.

# Supabase Postgres. Local dev: direct connection is fine.
# Render: use the SESSION POOLER string (Supabase > Connect > Session pooler, port 5432),
# because the direct host is IPv6-only.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# AI (Person 1). Leave empty to use the built-in mock at /mock/ai/*.
AI_PROCESS_URL=
AI_NARRATE_URL=
# Optional header sent on every AI call, format "Header-Name: value"
AI_AUTH_HEADER=
AI_TIMEOUT_SECONDS=10

# Protects POST /api/v1/admin/recompute (header X-Admin-Key). Empty = endpoint disabled.
ADMIN_KEY=change-me

# Tuning (defaults shown)
RECOMPUTE_DEBOUNCE_SECONDS=5
RECOMMENDATION_MAX_AGE_HOURS=24
AI_SAMPLE_SIZE=30
CORS_ORIGINS=*
DB_POOL_MIN=1
DB_POOL_MAX=5
